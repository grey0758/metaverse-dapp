{
  "name": "metaverse-dapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:node && pnpm godot:check",
    "check:node": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @metaverse/api --filter @metaverse/game-server --filter @metaverse/web-dapp dev",
    "godot:check": "bash scripts/check-godot-client.sh",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "contracts:test": "pnpm --filter @metaverse/contracts test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
